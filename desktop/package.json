{
  "name": "companion-desktop",
  "productName": "Companion",
  "version": "0.4.1",
  "description": "Windows desktop shell for the Blackoutburst companion",
  "private": true,
  "main": "main.js",
  "author": "Blackoutburst",
  "scripts": {
    "start": "electron .",
    "dist": "node scripts/build-nsis.js"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "26.18.0",
    "resedit": "^3.1.0"
  },
  "build": {
    "appId": "com.blackoutburst.companion",
    "productName": "Companion",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "afterPack": "scripts/after-pack.js",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Companion-Setup-${version}-x64.exe",
      "differentialPackage": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://blackoutburst.com/personal-agent-preview/api/desktop/update/"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
